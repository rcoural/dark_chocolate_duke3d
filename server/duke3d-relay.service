[Unit]
Description=Dark Chocolate Duke3D relay server
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/duke3d-relay 1635
Restart=on-failure
RestartSec=2
# Hardening: the relay needs nothing but a UDP socket.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
